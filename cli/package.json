{
  "name": "gradient.md",
  "version": "0.8.5",
  "private": true,
  "description": "Keep your Claude Code and Codex setup honest: mine your own history, check the configuration they load, and apply the changes you approve.",
  "homepage": "https://gradient.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elliot-ylambda/gradient.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/elliot-ylambda/gradient/issues"
  },
  "license": "MIT",
  "author": "ylambda",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin.js',0o755)\"",
    "build:plugin": "node scripts/build-plugin.mjs",
    "dogfood:run": "node scripts/dogfood.mjs",
    "dogfood": "npm run build && npm run build:plugin && node scripts/dogfood.mjs",
    "smoke:bin": "node scripts/smoke-bin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/node": "^20.16.0"
  }
}
